{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.gstatic.com https://cdnjs.cloudflare.com https://*.firebasedatabase.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://challenges.cloudflare.com https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/extend",
      "destination": "/api/admin/duration"
    },
    {
      "source": "/api/admin/reduce",
      "destination": "/api/admin/duration"
    },
    {
      "source": "/api/admin/upgrade-vip",
      "destination": "/api/admin/duration?action=upgrade"
    },
    {
      "source": "/api/admin/delete-security-event",
      "destination": "/api/admin/security-alerts?action=delete"
    },
    {
      "source": "/api/admin/clear-security-events",
      "destination": "/api/admin/security-alerts?action=clear"
    },
    {
      "source": "/api/admin/vouchers",
      "destination": "/api/admin/maintenance?vipAdminAction=vouchers"
    },
    {
      "source": "/api/admin/voucher-save",
      "destination": "/api/admin/maintenance?vipAdminAction=voucher-save"
    },
    {
      "source": "/api/admin/voucher-delete",
      "destination": "/api/admin/maintenance?vipAdminAction=voucher-delete"
    },
    {
      "source": "/api/admin/voucher-delete-all",
      "destination": "/api/admin/maintenance?vipAdminAction=voucher-delete-all"
    },
    {
      "source": "/api/admin/history-delete",
      "destination": "/api/admin/maintenance?vipAdminAction=history-delete"
    },
    {
      "source": "/api/admin/history-delete-all",
      "destination": "/api/admin/maintenance?vipAdminAction=history-delete-all"
    },
    {
      "source": "/api/admin/vip-orders",
      "destination": "/api/admin/maintenance?vipAdminAction=vip-orders"
    },
    {
      "source": "/api/admin/vip-order-delete",
      "destination": "/api/admin/maintenance?vipAdminAction=vip-order-delete"
    },
    {
      "source": "/api/admin/vip-order-delete-all",
      "destination": "/api/admin/maintenance?vipAdminAction=vip-order-delete-all"
    }
  ],
  "installCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR && npm install --no-fund --no-audit",
  "buildCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR && ./node_modules/.bin/next build"
}